# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3100
APP_URL=http://localhost:3100
WEB_URL=http://localhost:5173

# ─── Datastores ───────────────────────────────────────────────────────────────
# Ports are deliberately non-default (5435/5434/6380) so this project never
# collides with another Postgres or Redis already running locally.
# (5433 was already taken on this machine by something outside Docker.)
DATABASE_URL=postgresql://expenseiq:expenseiq@localhost:5435/expenseiq?schema=public
TEST_DATABASE_URL=postgresql://expenseiq:expenseiq@localhost:5434/expenseiq_test?schema=public
REDIS_URL=redis://localhost:6380

# ─── Auth (Phase 1) ───────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Mail (Phase 1) ───────────────────────────────────────────────────────────
# Left blank in dev — the mailer falls back to logging the email to stdout.
MAIL_FROM=ExpenseIQ <no-reply@expenseiq.local>
RESEND_API_KEY=

# ─── LLM (Phase 4) ────────────────────────────────────────────────────────────
# Optional until Phase 4. The NLU module fails loudly at init if it's missing.
#
# GEMINI_MODEL_PRO defaults to Flash on purpose: gemini-2.5-pro has a free-tier
# quota of ZERO (verified — it returns 429 "limit: 0"), so it only works once
# billing is enabled on the Google Cloud project. Switch it to gemini-2.5-pro
# after enabling billing to get the stronger model for extraction.
GEMINI_API_KEY=
GEMINI_MODEL_PRO=gemini-2.5-flash
GEMINI_MODEL_FLASH=gemini-2.5-flash
# Gemini 2.5 "thinks" before answering, billed as output tokens. Measured here:
# 610 thinking tokens and +2.1s for an identical extraction. 0 keeps the flow
# inside the design's ~4s budget; raise it if quality ever needs it.
GEMINI_THINKING_BUDGET=0
# Set to "fake" to use the deterministic stand-in adapter — no key, no network,
# no bill. Integration tests force this. Defaults to fake when no key is set.
LLM_DRIVER=
