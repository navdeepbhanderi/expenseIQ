# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3100
APP_URL=http://localhost:3100
WEB_URL=http://localhost:3000

# ─── Datastores ───────────────────────────────────────────────────────────────
# Ports are deliberately non-default (5435/5434/6380) so this project never
# collides with another Postgres or Redis already running locally.
# (5433 was already taken on this machine by something outside Docker.)
DATABASE_URL=postgresql://expenseiq:expenseiq@localhost:5435/expenseiq?schema=public
TEST_DATABASE_URL=postgresql://expenseiq:expenseiq@localhost:5434/expenseiq_test?schema=public
REDIS_URL=redis://localhost:6380
# "inline" runs background jobs in-process - no Redis needed, not durable.
# Defaults to inline in test, bull otherwise.
QUEUE_DRIVER=
# Where receipt uploads are written. Local disk; deployment is out of scope.
STORAGE_ROOT=./storage

# ─── Auth (Phase 1) ───────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Mail (Phase 1) ───────────────────────────────────────────────────────────
# Left blank in dev - the mailer falls back to logging the email to stdout.
# Resend only accepts a verified domain, or its shared onboarding sender.
# onboarding@resend.dev works with no setup but delivers ONLY to the email
# that owns the Resend account - fine for development, useless for real
# users. Verify a domain in Resend and change this before anyone else
# needs to receive a verification link or a bill reminder.
MAIL_FROM=ExpenseIQ <onboarding@resend.dev>
RESEND_API_KEY=

# ─── AI ───────────────────────────────────────────────────────────────────────
#
# The platform ships one provider. Groq allows 1,000 requests a day on
# openai/gpt-oss-20b, against OpenRouter's 50 a day per account and Gemini's
# ~20 per model - ceilings at which expense capture stops working rather than
# merely slowing down.
#
# Not llama-3.1-8b-instant, despite its far larger 14,400/day allowance: it
# rejects json_schema, and without the schema an 8B model returns JSON with
# keys of its own invention and every extracted field comes back empty.
#
# Users who want a different provider, a stronger model or their own quota add
# a key in Settings instead. That path supports Groq, OpenRouter and Gemini,
# is per profile, and is why there are no GEMINI_* or OPENROUTER_* variables
# here any more: a second platform provider nobody configured would be dead
# code whose fallback branch never ran and never got tested.
#
# Leave GROQ_API_KEY empty and the app uses a deterministic fake adapter, so it
# still runs end to end with no key and no bill. Tests force this with
# LLM_DRIVER=fake.
GROQ_API_KEY=
GROQ_MODELS_TEXT=openai/gpt-oss-20b
# No Groq model here reads images, so receipts need a user-supplied vision key.
GROQ_MODELS_VISION=
GROQ_TIMEOUT_MS=20000

# Encrypts user-supplied provider keys at rest. Generate with:
#   openssl rand -hex 32
#
# Encryption at rest, not zero-knowledge: the server decrypts to call the
# provider, so this protects a leaked dump or backup, not someone holding the
# server. Without it the bring-your-own-key feature is simply unavailable and
# the app still boots.
CREDENTIAL_ENCRYPTION_KEY=
