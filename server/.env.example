# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3100
APP_URL=http://localhost:3100
WEB_URL=http://localhost:3000

# ─── Datastores ───────────────────────────────────────────────────────────────
# Ports are deliberately non-default (5435/5434/6380) so this project never
# collides with another Postgres or Redis already running locally.
# (5433 was already taken on this machine by something outside Docker.)
DATABASE_URL=postgresql://expenseiq:expenseiq@localhost:5435/expenseiq?schema=public
TEST_DATABASE_URL=postgresql://expenseiq:expenseiq@localhost:5434/expenseiq_test?schema=public
REDIS_URL=redis://localhost:6380
# "inline" runs background jobs in-process — no Redis needed, not durable.
# Defaults to inline in test, bull otherwise.
QUEUE_DRIVER=
# Where receipt uploads are written. Local disk; deployment is out of scope.
STORAGE_ROOT=./storage

# ─── Auth (Phase 1) ───────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Mail (Phase 1) ───────────────────────────────────────────────────────────
# Left blank in dev — the mailer falls back to logging the email to stdout.
# Resend only accepts a verified domain, or its shared onboarding sender.
# onboarding@resend.dev works with no setup but delivers ONLY to the email
# that owns the Resend account — fine for development, useless for real
# users. Verify a domain in Resend and change this before anyone else
# needs to receive a verification link or a bill reminder.
MAIL_FROM=ExpenseIQ <onboarding@resend.dev>
RESEND_API_KEY=

# ─── LLM (Phase 4) ────────────────────────────────────────────────────────────
# Optional until Phase 4. The NLU module fails loudly at init if it's missing.
#
# EVERY Pro model has a free-tier quota of ZERO — verified against this key for
# gemini-2.5-pro, gemini-3-pro-preview and gemini-3.1-pro-preview, all of which
# return 429 "quota=0". They need billing on the Cloud project. Switch
# GEMINI_MODEL_PRO to gemini-3.1-pro-preview once billing is enabled.
#
# The two tiers point at *different* models on purpose. Each model carries its
# own daily quota on the free tier, so splitting extraction and merchant
# normalisation across two roughly doubles how far a free key goes.
#
# Both are comma-separated CHAINS, tried left to right. The adapter drops to
# the next model on 429 (quota), 404 (unknown model), 400 (rejected parameter)
# or 5xx, and records which model actually answered on the NluRequest.
#
# gemini-3.6-flash rejects thinkingConfig.thinkingBudget, which this adapter
# normally sends. It is still in the chain: the adapter detects that 400 once
# and retries the same model without the parameter.
GEMINI_API_KEY=
GEMINI_MODEL_PRO=gemini-3.5-flash,gemini-3.6-flash,gemini-2.5-flash
GEMINI_MODEL_FLASH=gemini-3.1-flash-lite,gemini-3.5-flash,gemini-2.5-flash
# Gemini 2.5 "thinks" before answering, billed as output tokens. Measured here:
# 610 thinking tokens and +2.1s for an identical extraction. 0 keeps the flow
# inside the design's ~4s budget; raise it if quality ever needs it.
GEMINI_THINKING_BUDGET=0
# Set to "fake" to use the deterministic stand-in adapter — no key, no network,
# no bill. Integration tests force this. Defaults to fake when no key is set.

# --- OpenRouter (primary LLM provider) ---
# Free tier is metered per ACCOUNT, not per model: 20 requests/minute, 50/day,
# rising to 1000/day once $10 of credits has been purchased at any point. The
# credits are a threshold, not a spend — free models never consume them.
#
# Model chains are comma-separated and optional; the adapter's measured
# defaults apply when blank. See openrouter.adapter.ts for what was measured.
OPENROUTER_API_KEY=
OPENROUTER_MODELS_TEXT=
OPENROUTER_MODELS_VISION=

# Provider order. Default is openrouter,gemini. Gemini stays in the chain
# because it is the only provider here that accepts audio or streams.
# LLM_DRIVER=fake selects the deterministic offline adapter used by tests.
LLM_DRIVER=
